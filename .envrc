# Development only: bypass HM's wrapper (it forces its own app name and init).
# Resolve the installed package instead of pinning a machine-specific store path.
# For another Neovim build, set AZITHRO_DEV_NVIM to its unwrapped executable.
dev_nvim=${AZITHRO_DEV_NVIM:-$(command -v nvim)}
if [[ -z "$dev_nvim" || ! -x "$dev_nvim" ]]; then
  printf 'Azithro: set AZITHRO_DEV_NVIM to an unwrapped Neovim executable\n' >&2
  return 1
fi
dev_nvim=$(realpath "$dev_nvim")
case "$dev_nvim" in
  /nix/store/*/bin/nvim)
    dev_package=${dev_nvim%/bin/nvim}
    case "$dev_package" in
      *-neovim-unwrapped-*) ;;
      *)
        dev_references=$(nix-store --query --references "$dev_package") || return 1
        dev_nvim=
        while IFS= read -r dev_reference; do
          case "$dev_reference" in
            /nix/store/*-neovim-unwrapped-*)
              dev_nvim="$dev_reference/bin/nvim"
              break
              ;;
          esac
        done <<< "$dev_references"
        if [[ -z "$dev_nvim" || ! -x "$dev_nvim" ]]; then
          printf 'Azithro: cannot find unwrapped Neovim; set AZITHRO_DEV_NVIM\n' >&2
          return 1
        fi
        ;;
    esac
    ;;
esac
PATH_add "${dev_nvim%/nvim}"

export NVIM_APPNAME=azithro
export AZITHRO_TOOL_PROVIDER=mason
# Never reuse HM's lock or Nix-specific debugger paths in the development app.
unset AZITHRO_PACK_LOCK AZITHRO_JS_DEBUG_COMMAND AZITHRO_JS_DEBUG_SERVER AZITHRO_CODELLDB_COMMAND AZITHRO_LIBLLDB_PATH

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
config_path="$config_home/$NVIM_APPNAME"
checkout=$(pwd -P)

mkdir -p "$config_home"
if [[ ! -e "$config_path" && ! -L "$config_path" ]]; then
  ln -s "$checkout" "$config_path"
elif [[ -L "$config_path" && "$(readlink "$config_path")" == "$checkout" ]]; then
  : # The development link already belongs to this checkout.
else
  printf 'Azithro: leaving existing config path untouched: %s\n' "$config_path" >&2
fi

unset config_home config_path checkout dev_nvim dev_package dev_references dev_reference
